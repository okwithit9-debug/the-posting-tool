# Copy to .env and load it (e.g. `set -a; source .env; set +a`),
# or export these in your shell. All values are placeholders.
# Anything set here overrides profile.json.

POSTING_TOOL_HANDLE=YOUR_HANDLE
POSTING_TOOL_CTA_HOST=yourdomain.com

# The Chrome profile you already have open and signed in (attach-only).
POSTING_TOOL_CHROME_PROFILE_DIRECTORY=Profile 1
POSTING_TOOL_CHROME_PROFILE_NAME=YOUR_CHROME_PROFILE_NAME
POSTING_TOOL_CDP=http://127.0.0.1:9222
POSTING_TOOL_ATTACH_CHROME=0

# Optional backup path (Playwright)
POSTING_TOOL_HEADLESS=0
POSTING_TOOL_PROFILE=
POSTING_TOOL_PROFILE_FILE=profile.json

# IANA timezone, e.g. UTC, Europe/Berlin, America/New_York
POSTING_TOOL_TIMEZONE=UTC
